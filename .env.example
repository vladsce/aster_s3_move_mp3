# Путь к записям на хосте. В контейнере это всегда /data/records.
HOST_RECORDS_DIR=/absolute/path/to/records
# Каталог журналов на хосте.
HOST_LOGS_DIR=./logs

# UID и GID владельца файлов записей. Контейнер работает от этого пользователя.
PUID=1000
PGID=1000
TZ=Europe/Chisinau

# Файлы старше этого числа месяцев попадают в архив. 0 — переносить все файлы.
AGE_MONTHS=3
# Пауза между проходами.
CHECK_INTERVAL_SECONDS=300
FILE_EXTENSIONS=.mp3

# Реквизиты: Облачные решения → Объектное хранилище (S3) → Управление → Доступы.
S3_ENDPOINT=https://s3.hoster.by
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
# path или virtual.
S3_ADDRESSING_STYLE=path
S3_PREFIX=records/

# Удалять локальный файл только после подтверждённой загрузки.
DELETE_AFTER_UPLOAD=true
# true: только записать в журнал, что было бы сделано.
DRY_RUN=false
LOG_LEVEL=INFO
